<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.loginwithdbms.LoggedInController">
   <children>
      <Label layoutX="126.0" layoutY="31.0" prefHeight="68.0" prefWidth="370.0" text="Welcome To the CodeFarmers!" textFill="#0f9e88">
         <font>
            <Font size="26.0" />
         </font>
      </Label>
      <Button fx:id="logout_btn" layoutX="229.0" layoutY="187.0" mnemonicParsing="false" prefHeight="58.0" prefWidth="143.0" style="-fx-background-color: #00FFFF;" text="Log out" textFill="#110e0e">
         <font>
            <Font size="24.0" />
         </font>
      </Button>
      <Label fx:id="userinfo" layoutX="132.0" layoutY="88.0" prefHeight="49.0" prefWidth="346.0" text="Hi....." textFill="#0f9e88">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button fx:id="viewPosts" layoutX="534.0" layoutY="361.0" mnemonicParsing="false" onAction="#switchToSecondScene" text="View posts" />
      <Button fx:id="post" layoutX="477.0" layoutY="361.0" mnemonicParsing="false" onAction="#switchToPostScene" text="Post" />
   </children>
</AnchorPane>
