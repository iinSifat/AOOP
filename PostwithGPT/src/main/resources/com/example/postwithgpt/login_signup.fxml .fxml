<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.loginwithdbms.LoginSignupController">
    <TextField fx:id="usernameField" layoutX="100" layoutY="100" promptText="Username"/>
    <PasswordField fx:id="passwordField" layoutX="100" layoutY="150" promptText="Password"/>

    <Button text="Login" layoutX="100" layoutY="200" onAction="#loginUser"/>
    <Button text="Sign Up" layoutX="200" layoutY="200" onAction="#signupUser"/>
</AnchorPane>
